# ==============================================================================
# DigiValuer Sentinel - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="DigiValuer Sentinel"
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_1234567890

# Database (PostgreSQL)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digivaluer_sentinel
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/digivaluer_sentinel
DB_ECHO=false

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Google Gemini LLM API (LangChain / Google GenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2

# DigiValuer Platform Integration
DIGIVALUER_API_BASE_URL=https://api.digivaluer.example.com/v1
DIGIVALUER_API_KEY=your_digivaluer_api_key_here
DIGIVALUER_API_TIMEOUT_SECONDS=30
DIGIVALUER_WEBHOOK_SECRET=your_webhook_signing_secret

# Agentic Workflow & Human-in-the-Loop Settings
HUMAN_IN_THE_LOOP=true
SCAN_INTERVAL_MINUTES=30
POLLING_INTERVAL_SECONDS=60
VALUATION_STALL_THRESHOLD_HOURS=24
AUTO_ESCALATION_ENABLED=true
AGENT_MAX_ITERATIONS=10

# Multi-Channel Notifications (SendGrid, Twilio, In-App Webhooks)
SENDGRID_API_KEY=your_sendgrid_api_key_or_mock
EMAIL_FROM_ADDRESS=sentinel@digivaluer.example.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_or_mock
TWILIO_AUTH_TOKEN=your_twilio_auth_token_or_mock
TWILIO_PHONE_NUMBER=+15551234567
